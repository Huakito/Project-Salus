GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# A sentence naming the crisis line where the robot is used. It is added to the
# scripted message the robot says when someone talks about harming themselves.
# Example: SALUS_CRISIS_HELPLINE=In the UK you can call Samaritans, free, on 116 123.
SALUS_CRISIS_HELPLINE=

# Optional (defaults shown):
# SALUS_WHISPER_MODEL=small.en
# SALUS_VOICE=en_US-amy-medium
